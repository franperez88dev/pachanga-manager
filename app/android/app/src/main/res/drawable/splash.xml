<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla de arranque para Android 7-11: fondo verde con el balón en el centro.
     (En Android 12+ la pinta el sistema con los atributos windowSplashScreen* de styles.xml.) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/verde" />
    <item
        android:width="200dp"
        android:height="200dp"
        android:gravity="center"
        android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
