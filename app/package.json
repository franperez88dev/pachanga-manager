{
  "name": "pachanga-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:movil": "vite build --mode movil",
    "preview": "vite preview",
    "android:sincronizar": "cap sync android",
    "version:subir": "npm version patch --no-git-tag-version",
    "version:subir-menor": "npm version minor --no-git-tag-version",
    "movil:comprobar": "powershell -NoProfile -ExecutionPolicy Bypass -File compilar-apk.ps1 -ComprobarMovil",
    "movil:instalar": "powershell -NoProfile -ExecutionPolicy Bypass -File compilar-apk.ps1 -Instalar",
    "movil:conectar": "powershell -NoProfile -ExecutionPolicy Bypass -File compilar-apk.ps1 -SoloConectar",
    "movil:compilar": "powershell -NoProfile -ExecutionPolicy Bypass -File compilar-apk.ps1"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.2"
  }
}
