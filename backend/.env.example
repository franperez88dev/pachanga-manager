# Copia este archivo como .env (en esta misma carpeta) y rellénalo.
# El .env NUNCA se sube a git.

# Clave para firmar los tokens de sesión. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Si la cambias, todos tendrán que volver a iniciar sesión.
SECRET_KEY=cambia-esto

# Base de datos. En local, SQLite (se crea en backend/instance/pachanga.db).
# En producción, la URL del PostgreSQL externo: postgresql://usuario:clave@host/bd
DATABASE_URL=sqlite:///pachanga.db

# CORS: la app Android (Capacitor) llama desde https://localhost.
CORS_ORIGENES=https://localhost
# 1 = permite también http://localhost:* y http://127.0.0.1:* (Vite en el navegador). Solo en local.
CORS_DESARROLLO=1

# 1 solo en el hosting (detrás de su proxy), para leer la IP real del cliente.
CONFIAR_EN_PROXY=0

# Opcionales (valores por defecto entre paréntesis):
# TOKEN_DIAS=90
# LOGIN_MAX_INTENTOS_MOTE=5
# LOGIN_MAX_INTENTOS_IP=10
# LOGIN_BLOQUEO_MINUTOS=15
# REGISTRO_MAX_POR_IP_HORA=5
# TOLERANCIA_REBARAJAR=0.5
