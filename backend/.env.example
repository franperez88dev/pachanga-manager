# PLANTILLA DE EJEMPLO. Este archivo SÍ se sube a git: NO escribas aquí claves de verdad.
#
# Cópialo como .env (en esta misma carpeta) y rellena el .env, que NUNCA se sube a git:
#   en tu PC (PowerShell):      copy .env.example .env
#   en PythonAnywhere (Bash):   cp .env.example .env

# Clave para firmar los tokens de sesión. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# y pégala en tu .env (no aquí). Usa una DISTINTA en tu PC y en PythonAnywhere.
# Si la cambias, todos tendrán que volver a iniciar sesión.
SECRET_KEY=cambia-esto

# 1 = permite que la web de desarrollo (Vite, puerto 5173) llame a esta API.
#   En tu PC:           1
#   En PythonAnywhere:  0   (allí la web y la API están en el mismo sitio)
CORS_DESARROLLO=1

# 1 = leer la IP real del visitante a través del proxy del hosting.
#   En tu PC:           0
#   En PythonAnywhere:  1   (imprescindible: si no, el bloqueo de intentos de login
#                            por IP bloquearía a toda la peña a la vez)
CONFIAR_EN_PROXY=0

# 1 = permite los comandos de prueba "flask datos-demo" y "flask demo-votar", que crean
# jugadores con el PIN 1111.
#   En tu PC:           1
#   En PythonAnywhere:  NO lo pongas (o déjalo a 0)
PERMITIR_DATOS_DEMO=1

# Opcionales (valores por defecto entre paréntesis):
# DATABASE_URL=sqlite:///pachanga.db     (el archivo backend/instance/pachanga.db)
# TOKEN_DIAS=90
# PIN_HASH_METODO=scrypt
# LOGIN_MAX_INTENTOS_MOTE=5
# LOGIN_MAX_INTENTOS_IP=10
# LOGIN_BLOQUEO_MINUTOS=15
# REGISTRO_MAX_POR_IP_HORA=5
# ZONA_HORARIA=Europe/Madrid
# HORAS_SIN_MULTA=24
# MULTA_INICIAL_CENTIMOS=0                (importe con el que nace una multa; 50 = 0,50 €)
# COBRADORES_HABITUALES=Feragi,Ortega     (nombres del desplegable "Pagar a")
# PRECIOS_HABITUALES_CENTIMOS=220,250     (precios del desplegable, en céntimos)
# TOLERANCIA_REBARAJAR=0.5
# VOTOS_PARA_REBARAJAR=6
# MAX_REPARTOS=3
